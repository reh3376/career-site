<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:640px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 8px;font-size:14px;color:#525252">rogerhenley.dev · JD review #{{.ID}}</p>
      <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3">{{if .Reminder}}One day left: {{.Pending}} follow-up {{if eq .Pending 1}}question{{else}}questions{{end}} on {{.Headline}}{{else}}Follow-up questions are waiting: {{.Headline}}{{end}}</h1>

      {{if .Reminder}}
      <p style="margin:0 0 16px;font-size:14px;line-height:1.5">The review of this posting is still waiting on <strong>{{.Pending}}</strong> of its {{.Questions}} follow-up {{if eq .Questions 1}}question{{else}}questions{{end}}.</p>
      {{else}}
      <p style="margin:0 0 16px;font-size:14px;line-height:1.5">The review of this posting could not settle <strong>{{.Questions}}</strong> {{if eq .Questions 1}}requirement{{else}}requirements{{end}} from the documents on file, and each one has a follow-up question for you.</p>
      {{end}}

      {{if .Held}}<p style="margin:0 0 16px;padding:10px 12px;background:#f5f5f5;border-left:3px solid #0f3d5c;font-size:13px;line-height:1.5">No fit is given while a question is open.{{if .Deadline}} If any are still open on <strong>{{.Deadline}}</strong>, they are closed unanswered and the fit is issued from what is evidenced.{{end}}</p>{{end}}

      <p style="margin:0 0 16px;font-size:14px;line-height:1.5">Each question shows the posting's own words and takes an answer, "I have not done this" or "prefer not to answer".</p>

      <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:20px">
        <tr>
          <td style="padding-right:12px">
            <a href="{{.QuestionsURL}}" style="display:inline-block;background:#0f3d5c;color:#ffffff;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:600">Answer the questions</a>
          </td>
          <td>
            <a href="{{.AdminURL}}" style="display:inline-block;background:transparent;color:#0f3d5c;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:600;border:1px solid #0f3d5c">The record as it stands</a>
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
