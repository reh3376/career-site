<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 16px;font-size:14px;color:#525252">career-site</p>
      <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3">Your access ends in about 3 days</h1>
      <p style="margin:0 0 16px;line-height:1.6">Hello {{.Name}}, heads up, your access to Roger Henley's career portfolio ends on <strong>{{.ExpiresAt}}</strong>.</p>
      <p style="margin:0 0 24px">
        <a href="{{.ExtensionMailto}}" style="display:inline-block;background:#0f3d5c;color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:600">Request extension</a>
      </p>
      <p style="margin:0 0 8px;font-size:13px;color:#525252">The button opens a pre-filled email to Roger at <a href="mailto:{{.OwnerEmail}}" style="color:#0f3d5c">{{.OwnerEmail}}</a>.</p>
      <p style="margin:0;font-size:12px;color:#737373">If nothing changes, your account will be disabled at that time. You can re-apply later; nothing else you need to do.</p>
    </td></tr>
  </table>
</body>
</html>
