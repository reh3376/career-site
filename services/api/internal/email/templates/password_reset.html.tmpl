<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 16px;font-size:14px;color:#525252">career-site</p>
      <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3">Your reset code</h1>
      <p style="margin:0 0 16px;line-height:1.6">Hello {{.Name}}, someone (hopefully you) asked to reset the password on your career-site account.</p>
      <p style="margin:0 0 8px;line-height:1.6">Go back to the reset page, choose your new password, and enter this code beside it:</p>
      <p style="margin:0 0 24px;font-family:ui-monospace,Menlo,Monaco,monospace;font-size:32px;letter-spacing:0.3em;color:#0f3d5c">{{.Code}}</p>
      <p style="margin:0 0 24px;line-height:1.6;font-size:14px;color:#525252">The code expires in {{.Minutes}}&nbsp;minutes and stops working after {{.Attempts}} wrong attempts.</p>
      <p style="margin:0;font-size:12px;color:#737373">If you did not request this, ignore this email; the code expires on its own and no change will happen. If someone else keeps trying, reach out to {{.OwnerEmail}}.</p>
    </td></tr>
  </table>
</body>
</html>
