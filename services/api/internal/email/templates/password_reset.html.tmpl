<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 16px;font-size:14px;color:#525252">career-site</p>
      <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3">Reset your password</h1>
      <p style="margin:0 0 16px;line-height:1.6">Hello {{.Name}}, someone (hopefully you) asked to reset the password on your career-site account.</p>
      <p style="margin:0 0 24px;line-height:1.6">Open the link below within 60&nbsp;minutes to set a new one:</p>
      <p style="margin:0 0 24px">
        <a href="{{.ResetURL}}" style="display:inline-block;background:#0f3d5c;color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:600">Reset password</a>
      </p>
      <p style="margin:0 0 8px;font-size:13px;color:#525252">Or paste this URL into your browser:</p>
      <p style="margin:0 0 24px;font-family:ui-monospace,Menlo,Monaco,monospace;font-size:12px;word-break:break-all;color:#0a0a0a">{{.ResetURL}}</p>
      <p style="margin:0;font-size:12px;color:#737373">If you did not request this, ignore this email, the link expires on its own and no change will happen. If someone else keeps trying, reach out to {{.OwnerEmail}}.</p>
    </td></tr>
  </table>
</body>
</html>
