<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:640px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 8px;font-size:14px;color:#525252">career-site · support inbox</p>
      <p style="margin:0 0 4px;font-size:12px;font-family:ui-monospace,monospace;color:#737373">{{.Category}}</p>
      <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3">{{.Subject}}</h1>

      <table cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:20px;font-size:13px">
        <tr><td style="padding:4px 0;color:#737373;width:110px">From</td><td style="padding:4px 0"><strong>{{.SenderName}}</strong> &lt;<a href="mailto:{{.SenderEmail}}" style="color:#0f3d5c">{{.SenderEmail}}</a>&gt;</td></tr>
        <tr><td style="padding:4px 0;color:#737373">Signed in</td><td style="padding:4px 0">{{if .Auth}}yes ({{.Auth}}){{else}}<span style="color:#92400e">no — anonymous</span>{{end}}</td></tr>
        <tr><td style="padding:4px 0;color:#737373">Ticket</td><td style="padding:4px 0;font-family:ui-monospace,monospace">{{.TicketID}}</td></tr>
        <tr><td style="padding:4px 0;color:#737373">Received</td><td style="padding:4px 0">{{.SubmittedAt}}</td></tr>
      </table>

      <div style="border-top:1px solid #e5e5e5;padding-top:16px;line-height:1.6;white-space:pre-wrap">{{.Body}}</div>

      <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:24px">
        <tr>
          <td style="padding-right:12px">
            <a href="mailto:{{.SenderEmail}}?subject=Re:%20{{.Subject}}" style="display:inline-block;background:#0f3d5c;color:#ffffff;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:600">Reply</a>
          </td>
          <td>
            <a href="{{.ReviewURL}}" style="display:inline-block;background:transparent;color:#0f3d5c;padding:10px 20px;border-radius:6px;text-decoration:none;font-weight:600;border:1px solid #0f3d5c">Open in admin</a>
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
