<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 16px;font-size:14px;color:#525252">career-site</p>
      <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3">Access request declined</h1>
      <p style="margin:0 0 16px;line-height:1.6">Hello {{.Name}}, your access request to Roger Henley's career portfolio was declined &mdash; admin did not recognize the credentials.</p>
      <p style="margin:0 0 16px;line-height:1.6">If you believe this is in error, reply to Roger at <a href="mailto:{{.OwnerEmail}}" style="color:#0f3d5c">{{.OwnerEmail}}</a> and paste the block below into your reply so he can look it up quickly:</p>
      <div style="margin:24px 0;padding:16px;background:#f5f5f5;border:1px solid #e5e5e5;border-radius:6px;font-family:ui-monospace,Menlo,Monaco,monospace;font-size:12px;color:#262626;white-space:pre-wrap;word-break:break-all">Reference:    {{.ReferenceID}}
Name:         {{.Name}}
Email:        {{.Email}}
Organization: {{.Organization}}
Stated role:  {{.StatedRole}}
Submitted at: {{.SubmittedAt}}
Decision:     declined
Review link:  {{.ReviewURL}}</div>
    </td></tr>
  </table>
</body>
</html>
