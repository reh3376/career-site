<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 16px;font-size:14px;color:#525252">career-site</p>
      <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3">Verify your email</h1>
      <p style="margin:0 0 16px;line-height:1.6">Hello {{.Name}}, thanks for requesting access to Roger Henley's career portfolio.</p>
      <p style="margin:0 0 24px;line-height:1.6">Confirm this is your address by clicking the button below (link is valid for 24&nbsp;hours):</p>
      <p style="margin:0 0 24px">
        <a href="{{.VerifyURL}}" style="display:inline-block;background:#0f3d5c;color:#ffffff;padding:12px 22px;border-radius:6px;text-decoration:none;font-weight:600">Verify email</a>
      </p>
      <p style="margin:0 0 8px;font-size:13px;color:#525252">Or enter this code at <a href="{{.CodeURL}}" style="color:#0f3d5c">{{.CodeURL}}</a>:</p>
      <p style="margin:0 0 24px;font-family:ui-monospace,Menlo,Monaco,monospace;font-size:24px;letter-spacing:2px">{{.Code}}</p>
      {{if .Whitelisted}}<p style="margin:0 0 16px;line-height:1.6;color:#525252">Your address is on Roger's invitation list, so your access is ready the moment you verify: sign in and you are in.</p>{{else}}<p style="margin:0 0 16px;line-height:1.6;color:#525252">After you verify, Roger reviews new accounts personally, usually within a day. You'll receive another email when he decides.</p>{{end}}
      <p style="margin:0;font-size:12px;color:#737373">If you did not create this account, ignore this email; nothing further will happen.</p>
    </td></tr>
  </table>
</body>
</html>
