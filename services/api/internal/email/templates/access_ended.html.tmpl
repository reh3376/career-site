<!doctype html>
<html>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#fafafa;color:#0a0a0a;margin:0;padding:24px">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 16px;font-size:14px;color:#525252">career-site</p>
      <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3">Your access has ended</h1>
      <p style="margin:0 0 16px;line-height:1.6">Hello {{.Name}}, your access to Roger Henley's career portfolio ended as of <strong>{{.ExpiresAt}}</strong>.</p>
      <p style="margin:0 0 16px;line-height:1.6">If you still want in, reply to this email or reach Roger at <a href="mailto:{{.OwnerEmail}}" style="color:#0f3d5c">{{.OwnerEmail}}</a> and he'll re-approve you.</p>
      <p style="margin:0;font-size:13px;color:#525252">If you're done, no action needed — this is a courtesy notice.</p>
    </td></tr>
  </table>
</body>
</html>
