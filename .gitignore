# build artifacts (repo-root only; do not match nested Go packages named `build`)
/build/
/dist/
*.binpb

# dependencies and environments
node_modules/
.venv/
__pycache__/
*.pyc
.uv-cache/

# framework build artifacts
.next/
next-env.d.ts
*.tsbuildinfo

# local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example

# private corpus — résumés, cover letters, interview prep, private writing.
# FSD A-05: material the owner does not want public is kept in private storage,
# never in the repository.
/docs/personal/

# owner's private local notes / deploy cheat sheet
/career-site-deploy-readme.md

# local staging dir for the private corpus mount (dev compose)
/.corpus-private/

# editor and OS
.DS_Store
.idea/
.vscode/
*.swp
