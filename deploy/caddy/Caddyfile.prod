# Production Caddyfile — replaces deploy/caddy/Caddyfile in compose overrides.
# Caddy auto-provisions a Let's Encrypt cert for the domain listed here and
# renews it in the background. HSTS + security headers per FSD §8.9.
#
# Override the domain via the ${SITE_DOMAIN} env var loaded from .env.prod
# (Caddy reads env at start; docker-compose passes it in).

{
    email {$LETSENCRYPT_EMAIL}
    # Uncomment to test the ACME staging endpoint instead of production
    # certificates while the DNS is still propagating:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_DOMAIN} {
    encode zstd gzip

    # Security headers — FSD NFR-SEC-02.
    header {
        # HSTS: two years, include subdomains, eligible for preload lists.
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict powerful browser APIs the site doesn't use. Adding
        # anything to this list should require a real product reason.
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), sync-xhr=()"
        X-Frame-Options "DENY"
        # Isolate the browsing context from other origins that could
        # embed / open us; blunts Spectre-style cross-origin leaks and
        # window.opener attacks. `same-origin` is the strictest
        # setting the site can support.
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        X-Permitted-Cross-Domain-Policies "none"
        # CSP: allow same-origin + Google Fonts (loaded by next/font in
        # its default configuration). `unsafe-inline` on style-src is
        # what next/font's runtime CSS needs; script-src stays without
        # unsafe-inline because Next.js already threads a per-request
        # nonce for its own inline bootstrap. Tighten further if a
        # future change makes the nonce path work here too.
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com https://api.github.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://api.github.com https://api.pwnedpasswords.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # /api/* -> Go API. Same-origin, so session cookies stay first-party
    # and no CORS is needed.
    handle /api/* {
        reverse_proxy api:8080
    }

    # Everything else -> Next.js.
    handle {
        reverse_proxy web:3000
    }
}
