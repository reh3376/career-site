<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pulls the server's backups to this Mac once a day. The path below is
  rewritten by install-mac.sh, which is the supported way to install it.

  StartCalendarInterval runs the job when the Mac next wakes if it was
  asleep at the scheduled time, which is the normal case for a laptop.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.rogerhenley.career-backup-pull</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/deploy/backup/pull-backups.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/backups/career-site/pull.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/backups/career-site/pull.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
