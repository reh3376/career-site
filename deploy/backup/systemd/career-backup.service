[Unit]
Description=Nightly Postgres dump for career-site
Documentation=file:///opt/career-site/deploy/backup/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=career
Group=career
WorkingDirectory=/opt/career-site
ExecStart=/opt/career-site/deploy/backup/pg-backup.sh
# A dump that hangs is a dump that never finishes; fail instead.
TimeoutStartSec=900
Nice=10
IOSchedulingClass=idle
