# career-site — production secrets template.
#
# Copy to `.env.prod` ON THE SERVER (never in the repo, never in this
# checkout). `.env.prod` is what docker-compose.prod.yml reads at boot.
# Every value below must be set to a real one for the site to work.

# ─── Public identity ─────────────────────────────────────────────────────
SITE_DOMAIN=rogerhenley.dev
# Address Let's Encrypt uses to notify you of expiring certs.
LETSENCRYPT_EMAIL=rogerhenley345@gmail.com

# ─── Container image tags ────────────────────────────────────────────────
# GHCR_OWNER defaults to reh3376. IMAGE_TAG picks the version to deploy —
# use a specific git SHA (e.g. 1747616) or a tagged release, never `latest`.
GHCR_OWNER=reh3376
IMAGE_TAG=

# ─── Application secrets ─────────────────────────────────────────────────
# Postgres superuser password — anything long and random.
POSTGRES_PASSWORD=

# Outbound social links surfaced on the public site (footer + IT
# landing). NEXT_PUBLIC_* are baked into the client bundle at build
# time and treated as public.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/reh3376

# Host directory bind-mounted read-only into the api container as the
# private corpus (visibility=corpus_only). Populated by `make sync-corpus`
# from the owner's machine; never part of the repo checkout. Each
# top-level subdirectory is a source_kind.
CORPUS_PRIVATE_HOST_DIR=/opt/career-site-private/corpus

# Ask Roger embedder. `stub` = deterministic pseudo-embedding (safe
# default, no external dep, scores are meaningless). `ollama` = real
# embeddings from the ollama service in the prod stack. After flipping,
# restart the sidecar and run "Embed sweep" on /admin/corpus until
# remaining = 0. The DB vector column is fixed at 768 dimensions to
# match nomic-embed-text; changing the model needs a dual-index
# migration, not just this variable.
SIDECAR_EMBED_PROVIDER=stub
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Memory cap for the ollama container. nomic-embed-text needs ~500-600 MB
# resident. On the CPX11 (2 GB) keep the cap at 900m and the keep-alive
# short so the model unloads between sweeps; raise both after the CPX31
# upgrade.
OLLAMA_MEM_LIMIT=900m
OLLAMA_KEEP_ALIVE=5m

# Password for the read-only role `career_admin_readonly` used by the
# /admin/db surface (see migration 00005). Long + random, different
# from POSTGRES_PASSWORD. The API applies this via ALTER ROLE at boot
# and reuses it in the DATABASE_URL_READONLY compose builds.
DB_READONLY_PASSWORD=

# MinIO admin creds. Keep long + random.
MINIO_ROOT_USER=career-site
MINIO_ROOT_PASSWORD=

# Resend API key for transactional email. Get from https://resend.com/
# after you verify SITE_DOMAIN's DNS with Resend. Format: re_xxxxxxxx.
RESEND_API_KEY=

# From: address on every outgoing message. Must be at a subdomain / domain
# you've verified with Resend. Format: "career-site <noreply@rogerhenley.dev>".
MAIL_FROM=

# Address that receives access-request approval emails.
OWNER_CONTACT_EMAIL=rogerhenley345@gmail.com

# HMAC signing key for the one-click Accept/Decline URLs in the approval
# emails (FR-AUTH-15). 32 bytes, hex-encoded (64 chars). Generate with:
#   openssl rand -hex 32
# Rotate whenever compromise is suspected — every emailed but-unclicked
# link is invalidated on rotation.
DECISION_TOKEN_SECRET=

# ─── Admin bootstrap ─────────────────────────────────────────────────────
# On first boot the API auto-creates this user with role=admin and
# status=active, so you can sign in immediately. On subsequent boots the
# password is re-hashed if it changed; the row is otherwise left alone.
ADMIN_USERNAME=
CAREER_SITE_ADMIN_PW=
