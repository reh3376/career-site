# career-site — environment variables template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` is committed and documents every variable the app or its
# deploy tooling reads. Never commit real secrets.
#
# Variables are grouped by which component reads them. A variable listed
# here but not yet consumed by any component is marked FUTURE.

# ─── API (services/api) ──────────────────────────────────────────────────
API_ADDR=:8080
API_ENV=development
API_READ_TIMEOUT_SECONDS=15
API_WRITE_TIMEOUT_SECONDS=30
# Postgres DSN. In compose the API uses postgres://career:career_dev_only@postgres:5432/career?sslmode=disable.
DATABASE_URL=postgres://career:career_dev_only@localhost:5432/career?sslmode=disable
# API_SKIP_MIGRATE=1 disables the auto-migrate on start (useful in tests).
API_SKIP_MIGRATE=

# ─── Sidecar (services/sidecar) ──────────────────────────────────────────
SIDECAR_ADDR=[::]:50051
SIDECAR_MAX_WORKERS=8
SIDECAR_SHUTDOWN_GRACE_SECONDS=5

# ─── Deploy — Hetzner Cloud (FUTURE, Phase 6) ────────────────────────────
# Personal API token from https://console.hetzner.cloud/ →
# your project → Security → API tokens. Scope: Read & Write.
# Used only by the deploy pipeline; runtime never reads it.
HETZNER_API_TOKEN=
